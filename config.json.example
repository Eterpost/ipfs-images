{
  "logging": {
    "transports": [
      { "type": "console", "level": "info" }
    ]
  },
  "redis": {
    "url": "redis://127.0.0.1:6379",
    "options": {},
    "prefix": { "attachments": "IMAGES_" },
    "index": { "datetime": "IMAGES.DATETIME.INDEX" }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8002,
    "auth": {
      "type": "partial",
      "allowedIPs": ["127\\.0\\.0\\.1", "::1", "::ffff:127\\.0\\.0\\.1"]
    },
    "allowedTypes": ["image/png", "image/jpeg", "image/gif", "image/webp"],
    "cache": 604800,
    "size": 26214400,
    "storage": {
      "type": "filesystem",
      "options": { "basePath": "/var/lib/ipfs-images/files" }
    },
    "headers": { "origin": "https://mailing.example.com" }
  },
  "thumbnails": {
    "cache": false,
    "path": "/var/lib/ipfs-images/thumbnails",
    "sizes": [64, 128, 192, 256, 512]
  }
}
